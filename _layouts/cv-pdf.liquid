---
layout: page
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      <a href="{{ page.cv_pdf | relative_url }}" download class="float-right" title="Download PDF">
        <i class="fa-solid fa-download"></i>
      </a>
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <embed src="{{ page.cv_pdf | relative_url }}" type="application/pdf" width="100%" height="800px" />
  </article>
</div>